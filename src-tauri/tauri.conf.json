{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collimator stand-demo",
  "version": "0.1.0",
  "identifier": "me.alex.collimator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
      "windows": [
      {
        "title": "Collimator Control System",
        "maximized" : true,
        "decorations": false,
        "transparent": false 
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
